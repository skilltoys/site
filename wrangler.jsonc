{
  // Cloudflare Workers config — static site served entirely from assets, no Worker code.
  "name": "site",
  "compatibility_date": "2026-08-30",
  // real domain is live — don't serve a duplicate on site.skilltoys.workers.dev
  "workers_dev": false,
  // custom domains attach on deploy (Workers Builds has the zone permissions)
  "routes": [
    { "pattern": "skilltoys.se", "custom_domain": true },
    { "pattern": "www.skilltoys.se", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    // /guider/foo/ -> guider/foo/index.html, Pages-style clean URLs
    "html_handling": "auto-trailing-slash",
    // serve /404.html with status 404 for unknown paths
    "not_found_handling": "404-page"
  }
}
